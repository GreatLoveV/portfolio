# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres connection string (use the pooled URL)
DATABASE_URL=

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=

# GitHub OAuth app. Callback: <site-url>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Numeric GitHub user id of the only account allowed into /admin.
# Find it at https://api.github.com/users/<your-username> ("id" field).
ADMIN_GITHUB_ID=

# Vercel Blob read/write token (image uploads)
BLOB_READ_WRITE_TOKEN=

# Public site origin, no trailing slash. Used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
